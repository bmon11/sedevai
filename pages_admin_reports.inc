// ---- /admin/reports (sections/report/*): Тайлан analytics with hand made svg charts (no apexcharts)
procedure AdmPage_Reports;
begin
  if not AdmPage('Тайлан', 'reports', 'xl') then exit;
  AdmBc('Тайлан', AdmCrumb('Тайлан'),
    '<div class="tgl" id="ranges"><button data-d="7">7 өдөр</button><button data-d="14" class="on">14 өдөр</button><button data-d="30">30 өдөр</button><button data-d="90">90 өдөр</button></div>');
  AW('<style>');
  AW('.chart .grid line{stroke:rgba(145,158,171,.2);stroke-dasharray:3 3}');
  AW('.chart rect.sbar:hover,.chart path.sl:hover{opacity:.8}');
  AW('.chart .hov{fill:transparent;cursor:crosshair}');
  AW('.chart .hov:hover{fill:rgba(145,158,171,.08)}');
  AW('.chart text.donut-c{font-size:13px;fill:var(--txt2)}');
  AW('.chart text.donut-v{font-size:26px;font-weight:700;fill:var(--txt)}');
  AW('.totals{display:flex;flex-wrap:wrap;gap:32px;padding:16px 24px 0}');
  AW('.totals .cap{display:block}.totals b{font-size:16px;font-weight:600}');
  AW('</style>');
  AW('<div id="body"><div class="spin"></div></div>');
  AW('<div class="tip" id="tip"></div>');
  AW('<script>');
  AdmJsCategories;
  AW('var COLORS = { politics: "#078DEE", economy: "#B76E00", society: "#118D57", world: "#8E33FF", sports: "#FF5630", culture: "#D63384", tech: "#006C9C" };');
  AW('function categoryColor(k) { return COLORS[k] || "#C4CDD5"; }');
  AW('function categoryLabel(k) { return CATEGORIES[k] ? CATEGORIES[k].label : k; }');
  AW('function fScore(x) { return Math.round((x || 0) * 100); }');
  AW('function fDay(d) { return String(d).slice(5).replace("-", "."); }');
  AW('var WEEKDAYS = ["Ням", "Даваа", "Мягмар", "Лхагва", "Пүрэв", "Баасан", "Бямба"];');
  AW('function fWeekday(d) { return WEEKDAYS[new Date(d + "T00:00:00Z").getUTCDay()]; }');
  AW('function sum(a) { return (a || []).reduce(function (s, x) { return s + (x || 0); }, 0); }');
  AW('var DAYS = 14, REPORT = null, METRIC = "score";');
  AW('// ---------- tooltip');
  AW('function tipShow(ev, html) { var t = $("tip"); t.innerHTML = html; t.style.display = "block"; tipMove(ev); }');
  AW('function tipMove(ev) { var t = $("tip"); var x = ev.pageX + 14, y = ev.pageY + 14; if (x + t.offsetWidth > window.scrollX + innerWidth - 8) x = ev.pageX - t.offsetWidth - 14; t.style.left = x + "px"; t.style.top = y + "px"; }');
  AW('function tipHide() { $("tip").style.display = "none"; }');
  AW('var TIPS = [];');
  AW('function tipAttr(html) { TIPS.push(html); var i = TIPS.length - 1; return " onmouseenter=\"tipShow(event,TIPS[" + i + "])\" onmousemove=\"tipMove(event)\" onmouseleave=\"tipHide()\""; }');
  AW('function niceMax(m) { if (m <= 0) return 1; var p = Math.pow(10, Math.floor(Math.log10(m))), n = m / p; return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10) * p; }');
  AW('function legend(items) { return "<div class=\"legend\">" + items.map(function (it) { return "<span><i style=\"background:" + it.color + "\"></i>" + esc(it.name) + "</span>"; }).join("") + "</div>"; }');
  AW('// ---------- stacked bar chart: labels[], series[{name,color,data[]}], fmtY(v), fmtTip(v)');
  AW('function stackedBars(labels, series, fmtY, fmtTip, height) {');
  AW('  var W = 900, H = height || 340, L = 56, R = 12, T = 12, B = 32, n = labels.length || 1;');
  AW('  var tot = labels.map(function (_, i) { return series.reduce(function (s, se) { return s + (se.data[i] || 0); }, 0); });');
  AW('  var max = niceMax(Math.max.apply(null, tot.concat([0])));');
  AW('  var cw = (W - L - R) / n, bw = Math.max(2, cw * 0.56);');
  AW('  var y = function (val) { return T + (H - T - B) * (1 - val / max); };');
  AW('  var s = "<svg viewBox=\"0 0 " + W + " " + H + "\" preserveAspectRatio=\"none\" style=\"height:" + H + "px\"><g class=\"grid\">";');
  AW('  for (var k = 0; k <= 4; k++) { var gv = max * k / 4; s += "<line x1=\"" + L + "\" x2=\"" + (W - R) + "\" y1=\"" + y(gv) + "\" y2=\"" + y(gv) + "\"/><text x=\"" + (L - 8) + "\" y=\"" + (y(gv) + 4) + "\" text-anchor=\"end\">" + fmtY(gv) + "</text>"; }');
  AW('  s += "</g>";');
  AW('  var every = Math.ceil(n / 16);');
  AW('  labels.forEach(function (lab, i) {');
  AW('    var x = L + cw * i + (cw - bw) / 2, base = 0;');
  AW('    series.forEach(function (se) {');
  AW('      var val = se.data[i] || 0; if (val <= 0) return;');
  AW('      var y1 = y(base + val), y0 = y(base); base += val;');
  AW('      s += "<rect class=\"sbar\" x=\"" + x + "\" y=\"" + y1 + "\" width=\"" + bw + "\" height=\"" + Math.max(0, y0 - y1) + "\" fill=\"" + se.color + "\" rx=\"2\"/>";');
  AW('    });');
  AW('    if (i % every === 0) s += "<text x=\"" + (L + cw * i + cw / 2) + "\" y=\"" + (H - 10) + "\" text-anchor=\"middle\">" + esc(lab) + "</text>";');
  AW('    var tip = "<b>" + esc(lab) + "</b>" + series.map(function (se) { return "<div><i style=\"display:inline-block;width:8px;height:8px;border-radius:50%;background:" + se.color + ";margin-right:6px\"></i>" + esc(se.name) + ": " + fmtTip(se.data[i] || 0) + "</div>"; }).join("");');
  AW('    s += "<rect class=\"hov\" x=\"" + (L + cw * i) + "\" y=\"" + T + "\" width=\"" + cw + "\" height=\"" + (H - T - B) + "\"" + tipAttr(tip) + "/>";');
  AW('  });');
  AW('  return s + "</svg>";');
  AW('}');
  AW('// ---------- donut');
  AW('function donut(rows, totalLabel) {');
  AW('  var tot = sum(rows.map(function (r) { return r.value; })), R = 120, r0 = R * 0.68, cx = 160, cy = 140, a = -Math.PI / 2;');
  AW('  var s = "<svg viewBox=\"0 0 320 280\" style=\"max-width:340px;margin:0 auto\">";');
  AW('  rows.forEach(function (row) {');
  AW('    var frac = tot ? row.value / tot : 0, a2 = a + frac * Math.PI * 2;');
  AW('    if (frac >= 0.9999) a2 = a + Math.PI * 2 - 0.0001;');
  AW('    var big = a2 - a > Math.PI ? 1 : 0;');
  AW('    var p = "M" + (cx + R * Math.cos(a)) + " " + (cy + R * Math.sin(a)) + " A" + R + " " + R + " 0 " + big + " 1 " + (cx + R * Math.cos(a2)) + " " + (cy + R * Math.sin(a2));');
  AW('    p += " L" + (cx + r0 * Math.cos(a2)) + " " + (cy + r0 * Math.sin(a2)) + " A" + r0 + " " + r0 + " 0 " + big + " 0 " + (cx + r0 * Math.cos(a)) + " " + (cy + r0 * Math.sin(a)) + " Z";');
  AW('    s += "<path class=\"sl\" d=\"" + p + "\" fill=\"" + row.color + "\"" + tipAttr("<b>" + esc(row.name) + "</b>: " + row.value + " оноо (" + Math.round(frac * 100) + "%)") + "/>";');
  AW('    a = a2;');
  AW('  });');
  AW('  s += "<text class=\"donut-c\" x=\"" + cx + "\" y=\"" + (cy - 6) + "\" text-anchor=\"middle\">" + totalLabel + "</text>";');
  AW('  s += "<text class=\"donut-v\" x=\"" + cx + "\" y=\"" + (cy + 24) + "\" text-anchor=\"middle\">" + tot + "</text>";');
  AW('  return s + "</svg>";');
  AW('}');
  AW('// ---------- multi line chart over time: series[{name,color,points:[[ms,val]]}], y 0..100');
  AW('function lines(series, height) {');
  AW('  var W = 900, H = height || 380, L = 40, R = 16, T = 12, B = 32;');
  AW('  var xs = []; series.forEach(function (se) { se.points.forEach(function (p) { xs.push(p[0]); }); });');
  AW('  if (!xs.length) return "<div class=\"empty\">—</div>";');
  AW('  var x0 = Math.min.apply(null, xs), x1 = Math.max.apply(null, xs); if (x1 === x0) { x0 -= 43200000; x1 += 43200000; }');
  AW('  var X = function (t) { return L + (W - L - R) * (t - x0) / (x1 - x0); }, Y = function (val) { return T + (H - T - B) * (1 - val / 100); };');
  AW('  var s = "<svg viewBox=\"0 0 " + W + " " + H + "\" style=\"height:" + H + "px\" preserveAspectRatio=\"none\"><g class=\"grid\">";');
  AW('  [0, 25, 50, 75, 100].forEach(function (gv) { s += "<line x1=\"" + L + "\" x2=\"" + (W - R) + "\" y1=\"" + Y(gv) + "\" y2=\"" + Y(gv) + "\"/><text x=\"" + (L - 8) + "\" y=\"" + (Y(gv) + 4) + "\" text-anchor=\"end\">" + gv + "</text>"; });');
  AW('  // x ticks: one per day (UB), max ~10');
  AW('  var day = 86400000, start = Math.ceil((x0 + UB_OFFSET_MS) / day) * day - UB_OFFSET_MS, step = Math.max(1, Math.ceil((x1 - x0) / day / 10)) * day;');
  AW('  for (var t = start; t <= x1; t += step) { var d = new Date(t + UB_OFFSET_MS); s += "<text x=\"" + X(t) + "\" y=\"" + (H - 10) + "\" text-anchor=\"middle\">" + pad(d.getUTCMonth() + 1) + "." + pad(d.getUTCDate()) + "</text>"; }');
  AW('  s += "</g>";');
  AW('  series.forEach(function (se) {');
  AW('    var pts = se.points.slice().sort(function (a, b) { return a[0] - b[0]; });');
  AW('    s += "<polyline fill=\"none\" stroke=\"" + se.color + "\" stroke-width=\"2.5\" stroke-linejoin=\"round\" points=\"" + pts.map(function (p) { return X(p[0]) + "," + Y(p[1]); }).join(" ") + "\"/>";');
  AW('    pts.forEach(function (p) {');
  AW('      s += "<circle cx=\"" + X(p[0]) + "\" cy=\"" + Y(p[1]) + "\" r=\"4\" fill=\"" + se.color + "\" stroke=\"#fff\" stroke-width=\"1.5\"" + tipAttr(esc(fDateTimeUB(p[0])) + "<br><b>" + esc(se.name) + "</b>: " + p[1] + " оноо") + "/>";');
  AW('    });');
  AW('  });');
  AW('  return s + "</svg>";');
  AW('}');
  AW('function card(title, sub, inner, cls, action) {');
  AW('  return "<div class=\"card " + (cls || "") + "\"><div class=\"ch\"><div class=\"x\"><h6>" + title + "</h6><div class=\"s\">" + sub + "</div></div>" + (action || "") + "</div>" + inner + "</div>";');
  AW('}');
  AW('// ---------- sections');
  AW('function kpis(r) {');
  AW('  var t = r.totals || {}, cd = r.categoryDaily || {};');
  AW('  var scoreOf = function (k) { return sum(cd[k] ? cd[k].score : []); };');
  AW('  var leader = (r.categories || []).slice().sort(function (a, b) { return scoreOf(b) - scoreOf(a); })[0];');
  AW('  var top = r.stories[0];');
  AW('  var tile = function (ic, l, val, hint) { return "<div class=\"card tile\"><span class=\"ic\">" + ic + "</span><div style=\"min-width:0\"><div class=\"lb\">" + l + "</div><div class=\"v\">" + esc(val) + "</div>" + (hint ? "<div class=\"h\" title=\"" + esc(hint) + "\">" + esc(hint) + "</div>" : "") + "</div></div>"; };');
  AW('  return "<div class=\"kpis full\">" +');
  AW('    tile(IC.docs, "Дугаар", t.editions || 0, (t.topics || 0) + " сэдэв нийтлэгдсэн") +');
  AW('    tile(IC.fire, "Үйл явдал", t.stories || 0, (t.newStories || 0) + " нь энэ хугацаанд шинээр гарсан") +');
  AW('    tile(IC.pie, "Тэргүүлсэн ангилал", leader && scoreOf(leader) > 0 ? categoryLabel(leader) : "—") +');
  AW('    tile(IC.cup, "Хамгийн халуун", top ? fScore(top.peak) : "—", top ? top.title : "") + "</div>";');
  AW('}');
  AW('function categoryTrend(r) {');
  AW('  var M = METRIC === "score" ? { unit: "оноо", val: fScore } : { unit: "үйл явдал", val: function (x) { return x || 0; } };');
  AW('  var series = (r.categories || []).map(function (k) { return { name: categoryLabel(k), color: categoryColor(k), data: ((r.categoryDaily[k] || {})[METRIC] || []).map(M.val) }; });');
  AW('  var act = "<div class=\"tgl\" id=\"metric\"><button data-m=\"score\" class=\"" + (METRIC === "score" ? "on" : "") + "\">Халуун оноо</button><button data-m=\"stories\" class=\"" + (METRIC === "stories" ? "on" : "") + "\">Үйл явдлын тоо</button></div>";');
  AW('  return card("Ангиллын хандлага", "Өдөр бүр аль ангилал хэр халуун байсан", legend(series) + "<div class=\"chart\">" +');
  AW('    stackedBars((r.days || []).map(fDay), series, function (x) { return Math.round(x); }, function (x) { return x + " " + M.unit; }, 340) + "</div>", "", act);');
  AW('}');
  AW('function categoryShare(r) {');
  AW('  var rows = (r.categories || []).map(function (k) { return { key: k, name: categoryLabel(k), color: categoryColor(k), value: fScore(sum((r.categoryDaily[k] || {}).score)) }; })');
  AW('    .filter(function (x) { return x.value > 0; }).sort(function (a, b) { return b.value - a.value; });');
  AW('  return card("Ангиллын хувь", "Хугацааны нийт халуун онооноос", "<div class=\"chart\">" + donut(rows, "Нийт оноо") + "</div>" + legend(rows) + "<div style=\"height:16px\"></div>");');
  AW('}');
  AW('var LINE_COLORS = ["#007BFF", "#B76E00", "#E50914", "#118D57", "#006C9C", "#FF5630", "#FFAB00", "#00B8D9"];');
  AW('function storyTrend(r) {');
  AW('  var byId = {}; r.stories.forEach(function (s) { byId[s.id] = s; });');
  AW('  var tr = function (t) { return t.length > 48 ? t.slice(0, 46) + "…" : t; };');
  AW('  var series = (r.trends || []).map(function (t, i) { return { name: tr((byId[t.id] || {}).title || ""), color: LINE_COLORS[i % LINE_COLORS.length],');
  AW('    points: (t.points || []).map(function (p) { return [new Date(p.at).getTime(), fScore(p.score)]; }) }; });');
  AW('  return card("Үйл явдлын хандлага", "Удаан яригдсан үйл явдлуудын халуун оноо дугаар бүрээр", "<div class=\"chart\">" + lines(series, 400) + "</div>" + legend(series) + "<div style=\"height:16px\"></div>", "full");');
  AW('}');
  AW('function dailyTop(r) {');
  AW('  var byId = {}; r.stories.forEach(function (s) { byId[s.id] = s; });');
  AW('  var days = (r.dailyTop || []).slice().reverse().filter(function (d) { return d.stories && d.stories.length; });');
  AW('  var h = "<div class=\"dtl\" style=\"padding:8px 24px 24px\">";');
  AW('  days.forEach(function (d, idx) {');
  AW('    if (idx > 0) h += "<hr>";');
  AW('    h += "<div class=\"day\"><div class=\"d\"><h5>" + fDay(d.day) + "</h5><div class=\"cap\">" + fWeekday(d.day) + "</div></div><div class=\"rows\">";');
  AW('    d.stories.forEach(function (e, rank) {');
  AW('      var st = byId[e.id] || { title: "", category: "" }, col = categoryColor(st.category);');
  AW('      h += "<div class=\"rw\"><span style=\"font-weight:600;color:var(--g500)\">" + (rank + 1) + "</span>";');
  AW('      h += "<span class=\"cat cap\" style=\"color:" + col + ";font-weight:600\">● " + esc(categoryLabel(st.category)) + "</span>";');
  AW('      h += "<a class=\"nm\" target=\"_blank\" rel=\"noopener\" title=\"" + esc(st.title) + "\" href=\"/topics/" + esc(st.topicId) + "\">" + esc(st.title) + "</a>";');
  AW('      h += "<div class=\"bar\"><i style=\"width:" + Math.min(100, fScore(e.score)) + "%;background:" + col + "\"></i></div>";');
  AW('      h += "<span style=\"font-weight:600;text-align:right\">" + fScore(e.score) + "</span></div>";');
  AW('    });');
  AW('    h += "</div></div>";');
  AW('  });');
  AW('  return card("Өдрийн халуун сэдвүүд", "Өдөр бүрийн хамгийн халуун 5 үйл явдал", h + "</div>", "full");');
  AW('}');
  AW('function storyTable(r) {');
  AW('  var h = "<div class=\"tc\" style=\"margin-top:16px;max-height:560px;overflow:auto\"><table class=\"t sticky\"><thead><tr><th>Үйл явдал</th><th>Ангилал</th><th>Анх гарсан</th><th class=\"r\">Дугаар</th><th class=\"r\">Өдөр</th><th class=\"r\">Дээд оноо</th></tr></thead><tbody>";');
  AW('  r.stories.forEach(function (s) {');
  AW('    h += "<tr class=\"h\"><td style=\"max-width:480px\"><a style=\"color:inherit\" target=\"_blank\" rel=\"noopener\" href=\"/topics/" + esc(s.topicId) + "\">" + esc(s.title) + "</a></td>";');
  AW('    h += "<td style=\"color:" + categoryColor(s.category) + ";font-weight:600;white-space:nowrap\">" + esc(categoryLabel(s.category)) + "</td>";');
  AW('    h += "<td class=\"muted\" style=\"white-space:nowrap\">" + fDateTimeUB(s.firstSeen) + "</td><td class=\"r\">" + s.editions + "</td><td class=\"r\">" + s.days + "</td>";');
  AW('    h += "<td class=\"r\" style=\"font-weight:600\">" + fScore(s.peak) + "</td></tr>";');
  AW('  });');
  AW('  return card("Бүх үйл явдал", "Нэг үйл явдал олон дугаарт гарвал нэг мөрөнд нэгтгэнэ", h + "</tbody></table></div>", "full");');
  AW('}');
  AW('function costChart(r, cls) {');
  AW('  var c = r.costs || { daily: [], totals: {} }, t = c.totals || {}, daily = c.daily || [];');
  AW('  var num = function (x) { return (x || 0).toLocaleString("en-US"); };');
  AW('  var tot = "<div class=\"totals\">" + [["Нийт", fUsd(t.total)], ["Сошиал", fUsd(t.social)], ["AI", fUsd(t.llm)], ["Сошиал хүсэлт", num(t.requests)], ["Кредит", num(t.credits)], ["AI токен", num(t.tokens)]]');
  AW('    .map(function (x) { return "<div><span class=\"cap\">" + x[0] + "</span><b>" + x[1] + "</b></div>"; }).join("") + "</div>";');
  AW('  var series = [{ name: "Сошиал", color: "#00B8D9", data: daily.map(function (d) { return Number((d.social || 0).toFixed(4)); }) },');
  AW('    { name: "AI (Gemini)", color: "#FFAB00", data: daily.map(function (d) { return Number((d.llm || 0).toFixed(4)); }) }];');
  AW('  return card("Зардал", "Өдөр бүрийн сошиал болон AI зардал (жагсаалтын үнээр)", tot + legend(series) + "<div class=\"chart\">" +');
  AW('    stackedBars(daily.map(function (d) { return fDay(d.day); }), series, function (x) { return "$" + x.toFixed(2); }, fUsd, 300) + "</div>", cls);');
  AW('}');
  AW('function render() {');
  AW('  var r = REPORT; TIPS = [];');
  AW('  if (!r.stories || !r.stories.length) {');
  AW('    $("body").innerHTML = "<div style=\"display:grid;gap:24px\"><div class=\"empty filled\"><h6>Энэ хугацаанд дугаар гараагүй</h6></div>" + costChart(r, "") + "</div>";');
  AW('    return;');
  AW('  }');
  AW('  $("body").innerHTML = "<div class=\"rgrid\">" + kpis(r) + categoryTrend(r) + categoryShare(r) + storyTrend(r) + dailyTop(r) + storyTable(r) + costChart(r, "full") + "</div>";');
  AW('  document.querySelectorAll("#metric button").forEach(function (b) { b.onclick = function () { METRIC = b.dataset.m; render(); }; });');
  AW('}');
  AW('function load() {');
  AW('  document.querySelectorAll("#ranges button").forEach(function (b) { b.disabled = true; });');
  AW('  if (!REPORT) $("body").innerHTML = "<div class=\"spin\"></div>";');
  AW('  apiGet("/api/admin/reports?days=" + DAYS).then(function (r) { REPORT = r || {}; REPORT.stories = REPORT.stories || []; render(); })');
  AW('    .catch(function (e) { $("body").innerHTML = alertBox("error", e.message); })');
  AW('    .then(function () { document.querySelectorAll("#ranges button").forEach(function (b) { b.disabled = false; }); });');
  AW('}');
  AW('document.querySelectorAll("#ranges button").forEach(function (b) {');
  AW('  b.onclick = function () { DAYS = Number(b.dataset.d); document.querySelectorAll("#ranges button").forEach(function (x) { x.classList.toggle("on", x === b); }); load(); };');
  AW('});');
  AW('var IC = { docs: ' + JEsc(AdmIcon('docs')) + ', fire: ' + JEsc(AdmIcon('fire')) + ', pie: ' + JEsc(AdmIcon('pie')) + ', cup: ' + JEsc(AdmIcon('cup')) + ' };');
  AW('load();');
  AW('</script>');
  AdmFoot;
end;
