// ---- content pages: /admin/topics, /admin/people, /admin/runs, /admin/runs/:id

// categories (sections/edition/categories.js) - pasted into pages that need them
procedure AdmJsCategories;
begin
  AW('var CATEGORIES = {');
  AW('  politics: { label: "Улс төр", color: "primary" },');
  AW('  economy: { label: "Эдийн засаг", color: "warning" },');
  AW('  society: { label: "Нийгэм", color: "info" },');
  AW('  world: { label: "Дэлхий", color: "secondary" },');
  AW('  sports: { label: "Спорт", color: "success" },');
  AW('  culture: { label: "Соёл", color: "error" },');
  AW('  tech: { label: "Технологи", color: "info" }');
  AW('};');
  AW('function categoryKey(k) { return CATEGORIES[k] ? k : "society"; }');
  AW('function getCategory(k) { return CATEGORIES[categoryKey(k)]; }');
end;

// ======================================================================= /admin/topics
procedure AdmPage_Topics;
begin
  if not AdmPage('Сэдвүүд', 'topics.view', '') then exit;
  AdmBc('Сэдвүүд', AdmCrumb('Сэдвүүд'), '');
  AW('<div class="alert info">Нийтлэгдсэн сэдвүүд, шинэ нь эхэндээ. Засвар болон нуух/харуулах өөрчлөлт уншигчийн сайтад 5 минутын дотор харагдана.</div>');
  AW('<div id="err"></div>');
  AW('<div class="card"><div class="tc"><table class="t"><thead><tr>');
  AW('<th>Нийтэлсэн</th><th>Сэдэв</th><th>Ангилал</th><th>Харагдах</th><th>Засварласан</th><th></th>');
  AW('</tr></thead><tbody id="rows"><tr><td colspan="6"><div class="lin"></div></td></tr></tbody></table></div></div>');
  // topic dialog (sections/topic-admin/topic-dialog.jsx)
  AW('<div class="dlgbg" id="tDlg"><div class="dlg"><form onsubmit="return saveTopic(event)">');
  AW('<h2>Сэдэв засах</h2><div class="bd"><div id="tErr"></div>');
  AW(AdmFld('tTitle', 'Гарчиг (асуулт) *', 'textarea', '', 'required rows="2"'));
  AW(AdmFld('tReason', 'Сонгосон шалтгаан', 'textarea', 'Нүүр хуудсан дээрх картад харагдана', 'rows="2"'));
  AW(AdmSel('tCat', 'Ангилал', AdmOpt('politics', 'Улс төр') + AdmOpt('economy', 'Эдийн засаг') + AdmOpt('society', 'Нийгэм') +
    AdmOpt('world', 'Дэлхий') + AdmOpt('sports', 'Спорт') + AdmOpt('culture', 'Соёл') + AdmOpt('tech', 'Технологи'), '', ''));
  AW('</div><div class="ft"><button type="button" class="btn o" onclick="closeDlg(&quot;tDlg&quot;)">Болих</button>');
  AW('<button type="submit" class="btn c" id="tSave">Хадгалах</button></div></form></div></div>');
  AW('<script>');
  AdmJsCategories;
  AW('var TOPICS = [], EDITING = null;');
  AW('var canEdit = can("topics.edit"), canHide = can("topics.hide");');
  AW('function load() {');
  AW('  apiGet("/api/admin/topics").then(function (d) { TOPICS = d || []; render(); }).catch(function (e) {');
  AW('    showErr("err", e.message); TOPICS = []; render(); });');
  AW('}');
  AW('function render() {');
  AW('  var h = "";');
  AW('  TOPICS.forEach(function (t, i) {');
  AW('    var c = getCategory(t.category);');
  AW('    h += "<tr class=\"h" + (t.hidden ? " dim" : "") + "\">";');
  AW('    h += "<td style=\"white-space:nowrap\">" + fDateTimeUB(t.createdAt) + "</td>";');
  AW('    h += "<td style=\"max-width:480px\"><div style=\"font-weight:600\">" + esc(t.title) + "</div><div class=\"muted ellip\">" + esc(t.reason) + "</div></td>";');
  AW('    h += "<td>" + lbl(c.label, c.color) + "</td>";');
  AW('    if (canHide) h += "<td><label class=\"sw\"><input type=\"checkbox\" " + (t.hidden ? "" : "checked") + " onchange=\"toggleVis(" + i + ")\"><span></span></label></td>";');
  AW('    else h += "<td>" + lbl(t.hidden ? "Нуусан" : "Харагдана", t.hidden ? "" : "success") + "</td>";');
  AW('    h += "<td class=\"muted\">" + esc(t.editedBy || "—") + "</td>";');
  AW('    h += "<td class=\"r\" style=\"white-space:nowrap\">";');
  AW('    if (!t.hidden) h += "<a class=\"btn sm t\" target=\"_blank\" href=\"/topics/" + esc(t._id) + "\">Нээх</a>";');
  AW('    if (canEdit) h += "<button class=\"btn sm t\" onclick=\"editTopic(" + i + ")\">Засах</button>";');
  AW('    h += "</td></tr>";');
  AW('  });');
  AW('  if (!TOPICS.length) h = "<tr><td colspan=\"6\" class=\"empty\">Одоогоор нийтлэгдсэн сэдэв алга</td></tr>";');
  AW('  $("rows").innerHTML = h;');
  AW('}');
  AW('function toggleVis(i) {');
  AW('  var t = TOPICS[i]; showErr("err", "");');
  AW('  api("PUT", "/api/admin/topics/" + t._id + "/visibility", { hidden: !t.hidden }).then(load).catch(function (e) { showErr("err", e.message); render(); });');
  AW('}');
  AW('function editTopic(i) {');
  AW('  EDITING = TOPICS[i]; showErr("tErr", "");');
  AW('  setv("tTitle", EDITING.title); setv("tReason", EDITING.reason); setv("tCat", categoryKey(EDITING.category));');
  AW('  openDlg("tDlg");');
  AW('}');
  AW('function saveTopic(ev) {');
  AW('  ev.preventDefault(); showErr("tErr", "");');
  AW('  var b = $("tSave"); busy(b, true);');
  AW('  api("PUT", "/api/admin/topics/" + EDITING._id, { title: v("tTitle"), reason: v("tReason"), category: v("tCat") })');
  AW('    .then(function () { closeDlg("tDlg"); load(); }).catch(function (e) { showErr("tErr", e.message); }).then(function () { busy(b, false); });');
  AW('  return false;');
  AW('}');
  AW('load();');
  AW('</script>');
  AdmFoot;
end;

// ======================================================================= /admin/people
procedure AdmPage_People;
begin
  if not AdmPage('Хүмүүс', 'entities', '') then exit;
  AdmBc('Хүмүүс', AdmCrumb('Хүмүүс'), '<button class="btn c" onclick="editEntity(-1)">' + AdmIcon('add') + 'Нэмэх</button>');
  AW('<div class="alert info">Мэдээ цуглуулах ажил шинэ нийтлэл бүрээс эдгээр хүмүүсийг хайна. Албан тушаал өөрчлөгдвөл шинэчилнэ үү: AI нэр давхцлыг түүгээр ялгадаг. Шинэ нэр зөвхөн цаашид ирэх мэдээнд үйлчилнэ.</div>');
  AW('<div id="err"></div>');
  AW('<div class="card"><div class="tc"><table class="t"><thead><tr>');
  AW('<th>Нэр</th><th>Албан тушаал</th><th>Хайх нэрс</th><th class="r">Мэдээ</th><th></th>');
  AW('</tr></thead><tbody id="rows"><tr><td colspan="5"><div class="lin"></div></td></tr></tbody></table></div></div>');
  // entity dialog (sections/entity-admin/entity-dialog.jsx)
  AW('<div class="dlgbg" id="eDlg"><div class="dlg"><form onsubmit="return saveEntity(event)">');
  AW('<h2 id="eT">Шинэ хүн</h2><div class="bd"><div id="eErr"></div>');
  AW(AdmFld('eName', 'Овог нэр *', 'text', 'Жишээ: Ням-Осорын Учрал', 'required'));
  AW('<div class="row">' + AdmFld('eShort', 'Товч нэр *', 'text', 'Жишээ: Н.Учрал', 'required') +
    AdmFld('eSlug', 'Хаяг *', 'text', '/people/uchral — латин жижиг үсэг', 'required') + '</div>');
  AW(AdmFld('eTitle', 'Албан тушаал', 'text', '', ''));
  AW(AdmFld('eAliases', 'Хайх нэрс *', 'text', 'Таслалаар тусгаарла. Нэр хувирдаг бол үндсийг бич: Баттулга → Баттулг. Том үсгээр эхэлнэ.', 'required'));
  AW(AdmFld('eDesc', 'Товч танилцуулга', 'textarea', '', 'rows="3"'));
  AW(AdmSw('eEnabled', 'Уншигчийн сайтад харуулах, мэдээнээс хайх', ''));
  AW('</div><div class="ft"><button type="button" class="btn o" onclick="closeDlg(&quot;eDlg&quot;)">Болих</button>');
  AW('<button type="submit" class="btn c" id="eSave">Хадгалах</button></div></form></div></div>');
  AW('<script>');
  AW('var ENTS = [], EDITING = null;');
  AW('var emptyEntity = { slug: "", name: "", shortName: "", title: "", description: "", aliases: [], enabled: true };');
  AW('function load() {');
  AW('  apiGet("/api/admin/entities").then(function (d) { ENTS = d || []; render(); }).catch(function (e) { showErr("err", e.message); ENTS = []; render(); });');
  AW('}');
  AW('function render() {');
  AW('  var h = "";');
  AW('  ENTS.forEach(function (e, i) {');
  AW('    h += "<tr class=\"h" + (e.enabled ? "" : " dim") + "\">";');
  AW('    h += "<td><a style=\"color:inherit\" target=\"_blank\" href=\"/people/" + esc(e.slug) + "\">" + esc(e.shortName) + "</a></td>";');
  AW('    h += "<td>" + esc(e.title) + "</td><td>" + esc((e.aliases || []).join(", ")) + "</td>";');
  AW('    h += "<td class=\"r\">" + (e.mentions || 0) + "</td>";');
  AW('    h += "<td class=\"r\"><button class=\"btn sm t\" onclick=\"editEntity(" + i + ")\">Засах</button></td></tr>";');
  AW('  });');
  AW('  if (!ENTS.length) h = "<tr><td colspan=\"5\" class=\"empty\">Хүн алга</td></tr>";');
  AW('  $("rows").innerHTML = h;');
  AW('}');
  AW('function editEntity(i) {');
  AW('  EDITING = i < 0 ? emptyEntity : ENTS[i]; showErr("eErr", "");');
  AW('  $("eT").textContent = EDITING._id ? EDITING.name : "Шинэ хүн";');
  AW('  setv("eName", EDITING.name); setv("eShort", EDITING.shortName); setv("eSlug", EDITING.slug);');
  AW('  $("eSlug").disabled = !!EDITING._id;');
  AW('  setv("eTitle", EDITING.title); setv("eAliases", (EDITING.aliases || []).join(", ")); setv("eDesc", EDITING.description);');
  AW('  setchk("eEnabled", EDITING.enabled !== false);');
  AW('  openDlg("eDlg");');
  AW('}');
  AW('function saveEntity(ev) {');
  AW('  ev.preventDefault(); showErr("eErr", "");');
  AW('  var body = { slug: v("eSlug").trim(), name: v("eName"), shortName: v("eShort"), title: v("eTitle"), description: v("eDesc"),');
  AW('    aliases: v("eAliases").split(",").map(function (a) { return a.trim(); }).filter(Boolean), enabled: chk("eEnabled") };');
  AW('  var b = $("eSave"); busy(b, true);');
  AW('  var p = EDITING._id ? api("PUT", "/api/admin/entities/" + EDITING._id, body) : api("POST", "/api/admin/entities", body);');
  AW('  p.then(function () { closeDlg("eDlg"); load(); }).catch(function (e) { showErr("eErr", e.message); }).then(function () { busy(b, false); });');
  AW('  return false;');
  AW('}');
  AW('load();');
  AW('</script>');
  AdmFoot;
end;

// run constants (sections/run/constants.js) pasted into both run pages
procedure AdmJsRunConsts;
begin
  AW('var RUN_STAGES = [');
  AW('  { key: "collect", label: "Цуглуулах", progress: "Цуглуулж байна" },');
  AW('  { key: "extract", label: "Хүн таних", progress: "Мэдээнээс хүмүүсийг таньж байна" },');
  AW('  { key: "social", label: "Сошиал", progress: "Сошиал цуглуулж байна" },');
  AW('  { key: "cluster", label: "Бүлэглэх", progress: "Бүлэглэж байна" },');
  AW('  { key: "select", label: "Сонгох", progress: "Сонгож байна" },');
  AW('  { key: "wrap", label: "Задлан шинжлэх", progress: "Задлан шинжилж байна" },');
  AW('  { key: "publish", label: "Нийтлэх", progress: "Нийтэлж байна" }');
  AW('];');
  AW('var RUN_KINDS = {');
  AW('  news: { label: "Вэб", start: "Вэб цуглуулах", stages: ["collect", "extract"] },');
  AW('  social: { label: "Сошиал", start: "Сошиал цуглуулах", stages: ["social"] },');
  AW('  publish: { label: "Нийтлэх", start: "Нийтлэх", stages: ["cluster", "select", "wrap", "publish"] },');
  AW('  world: { label: "Гадаад", start: "Гадаад мэдээ", stages: ["collect", "cluster", "select", "wrap", "publish"] }');
  AW('};');
  AW('function stagesOf(kind) { return RUN_KINDS[kind] ? RUN_STAGES.filter(function (s) { return RUN_KINDS[kind].stages.indexOf(s.key) >= 0; }) : RUN_STAGES; }');
  AW('function kindLabel(kind) { return RUN_KINDS[kind] ? RUN_KINDS[kind].label : "Бүтэн"; }');
  AW('function stageProgressLabel(st) { if (st === "done") return "Дууссан"; var s = RUN_STAGES.find(function (x) { return x.key === st; }); return s ? s.progress : (st || ""); }');
  AW('var RUN_STATUS = { running: { label: "Явж байна", color: "info" }, succeeded: { label: "Амжилттай", color: "success" },');
  AW('  failed: { label: "Алдаатай", color: "error" }, skipped: { label: "Алгассан", color: "" } };');
  AW('function statusLabel(s) { var x = RUN_STATUS[s] || { label: s, color: "" }; return lbl(x.label, x.color); }');
  AW('var SOURCE_REPORT_COLOR = { ok: "success", partial: "warning", failed: "error", skipped: "" };');
end;

// ======================================================================= /admin/runs
procedure AdmPage_Runs;
var
  act: string;
begin
  if not AdmPage('Ажиллагаа', 'runs.view', '') then exit;
  act := '';
  if Can(JStr(AdmMe, 'role'), 'runs.start') then
    act := '<button class="btn o p" id="st_news" onclick="startRun(&quot;news&quot;)">' + AdmIcon('globe') + 'Вэб цуглуулах</button>' +
      '<button class="btn o p" id="st_social" onclick="startRun(&quot;social&quot;)">' + AdmIcon('users') + 'Сошиал цуглуулах</button>' +
      '<button class="btn c" id="st_publish" onclick="startRun(&quot;publish&quot;)">' + AdmIcon('play') + 'Нийтлэх</button>' +
      '<button class="btn o p" id="st_world" onclick="startRun(&quot;world&quot;)">' + AdmIcon('globe') + 'Гадаад мэдээ</button>';
  AdmBc('Ажиллагаа', AdmCrumb('Ажиллагаа'), act);
  AW('<div id="err"></div>');
  AW('<div class="card"><div class="tabs" id="tabs">');
  AW('<button class="tab on" data-k="all">Бүгд</button><button class="tab" data-k="news">Вэб</button><button class="tab" data-k="social">Сошиал</button>');
  AW('<button class="tab" data-k="publish">Нийтлэх</button><button class="tab" data-k="world">Гадаад</button></div>');
  AW('<div class="tc"><table class="t"><thead><tr>');
  AW('<th>Эхэлсэн</th><th>Ажил</th><th>Эхлүүлсэн</th><th>Төлөв</th><th>Үе шат</th><th class="r">Нийтлэл / пост</th><th class="r">Сэдэв</th><th class="r">Токен</th>');
  AW('</tr></thead><tbody id="rows"><tr><td colspan="8"><div class="lin"></div></td></tr></tbody></table></div></div>');
  AW('<script>');
  AdmJsRunConsts;
  AW('var KIND = "all", RUNS = [], TIMER = null;');
  AW('document.querySelectorAll("#tabs .tab").forEach(function (b) {');
  AW('  b.onclick = function () { KIND = b.dataset.k; document.querySelectorAll("#tabs .tab").forEach(function (x) { x.classList.toggle("on", x === b); }); load(); };');
  AW('});');
  AW('function load() {');
  AW('  clearTimeout(TIMER);');
  AW('  var url = KIND === "all" ? "/api/admin/runs" : "/api/admin/runs?kind=" + KIND;');
  AW('  apiGet(url).then(function (d) {');
  AW('    RUNS = d || []; render();');
  AW('    // refresh every 4s while something runs (SWR refreshInterval)');
  AW('    if (RUNS.some(function (r) { return r.status === "running"; })) TIMER = setTimeout(load, 4000);');
  AW('  }).catch(function (e) { showErr("err", e.message); RUNS = []; render(); });');
  AW('}');
  AW('function render() {');
  AW('  var h = "";');
  AW('  RUNS.forEach(function (r) {');
  AW('    h += "<tr class=\"h click\" onclick=\"location.href=&quot;/admin/runs/" + esc(r._id) + "&quot;\">";');
  AW('    h += "<td>" + fDateTimeUB(r.startedAt) + "</td><td>" + kindLabel(r.kind) + "</td>";');
  AW('    h += "<td>" + (r.trigger === "schedule" ? "Хуваарь" : "Гараар") + "</td><td>" + statusLabel(r.status) + "</td>";');
  AW('    h += "<td>" + esc(r.status === "skipped" ? r.note : stageProgressLabel(r.stage)) + "</td>";');
  AW('    h += "<td class=\"r\">" + ((r.kind === "social" ? r.postCount : r.articleCount) || 0) + "</td>";');
  AW('    h += "<td class=\"r\">" + (r.topicIds || []).length + (r.reusedWraps ? " (" + r.reusedWraps + " дахин)" : "") + "</td>";');
  AW('    h += "<td class=\"r\">" + fTokens(r.usage) + "</td></tr>";');
  AW('  });');
  AW('  if (!RUNS.length) h = "<tr><td colspan=\"8\" class=\"empty\">Одоогоор ажиллагаа алга</td></tr>";');
  AW('  $("rows").innerHTML = h;');
  AW('  Object.keys(RUN_KINDS).forEach(function (k) {');
  AW('    var b = $("st_" + k); if (b) b.disabled = RUNS.some(function (r) { return r.status === "running" && r.kind === k; });');
  AW('  });');
  AW('}');
  AW('function startRun(kind) {');
  AW('  showErr("err", "");');
  AW('  api("POST", "/api/admin/runs", { kind: kind }).then(function (d) { location.href = "/admin/runs/" + d._id; })');
  AW('    .catch(function (e) { showErr("err", e.message); });');
  AW('}');
  AW('load();');
  AW('</script>');
  AdmFoot;
end;

// ======================================================================= /admin/runs/:id
procedure AdmPage_Run(const id: string);
begin
  if not AdmPage('Ажиллагаа', 'runs.view', '') then exit;
  AW('<div class="bc"><div class="l"><h4 id="bcH">Ажиллагаа</h4>');
  AW('<div class="links"><a href="/admin/runs">Ажиллагаа</a><span class="dot"></span><span class="last" id="bcL"></span></div></div>');
  AW('<div class="act" id="bcAct"></div></div>');
  AW('<div id="body"><div class="lin"></div></div>');
  AW('<script>');
  AdmJsRunConsts;
  AW('var RUN_ID = ' + StringReplace(JEsc(id), '<', '<', [rfReplaceAll]) + ', TIMER = null, ERR = "";');
  AW('function load() {');
  AW('  clearTimeout(TIMER);');
  AW('  apiGet("/api/admin/runs/" + encodeURIComponent(RUN_ID)).then(function (run) {');
  AW('    render(run);');
  AW('    if (run && run.status === "running") TIMER = setTimeout(load, 3000);');
  AW('  }).catch(function (e) {');
  AW('    $("body").innerHTML = alertBox("error", e.status === 404 ? "Ажиллагаа олдсонгүй" : e.message);');
  AW('  });');
  AW('}');
  AW('function resume() {');
  AW('  ERR = "";');
  AW('  api("POST", "/api/admin/runs/" + encodeURIComponent(RUN_ID) + "/resume").then(load).catch(function (e) { ERR = e.message; load(); });');
  AW('}');
  AW('function card(title, inner) { return "<div class=\"card\"><div class=\"ch\"><div class=\"x\"><h6>" + title + "</h6></div></div>" + inner + "</div>"; }');
  AW('function render(run) {');
  AW('  var started = fDateTimeUB(run.startedAt);');
  AW('  $("bcH").textContent = "Ажиллагаа " + started; $("bcL").textContent = started;');
  AW('  document.title = "Ажиллагаа " + started + " · Сэдэв.мн";');
  AW('  $("bcAct").innerHTML = run.editionId ? "<a class=\"btn o\" href=\"/editions/" + esc(run.editionId) + "\">Нийтлэгдсэн багцыг харах</a>" : "";');
  AW('  var u = run.usage || {}, stages = stagesOf(run.kind);');
  AW('  var active = run.stage === "done" ? stages.length : stages.findIndex(function (s) { return s.key === run.stage; });');
  AW('  var h = "<div class=\"st\">";');
  AW('  h += "<div style=\"display:flex;gap:12px;align-items:center;flex-wrap:wrap\">" + lbl(kindLabel(run.kind)) + statusLabel(run.status);');
  AW('  h += "<span class=\"muted\">Хугацаа " + esc(fWindow(run.window)) + " · " + (run.articleCount || 0) + " нийтлэл · " + (run.postCount || 0) + " пост · ";');
  AW('  h += (u.calls || 0) + " AI дуудалт · " + fTokens(u) + " токен · AI " + fUsd(u.costUsd);');
  AW('  if (run.socialUsage && run.socialUsage.requests) h += " · Сошиал " + fUsd(run.socialUsage.costUsd);');
  AW('  if (run.reusedWraps) h += " · " + run.reusedWraps + " задлалыг дахин ашигласан";');
  AW('  h += "</span></div>";');
  AW('  // stepper');
  AW('  h += "<div class=\"card p3\"><div class=\"steps\">";');
  AW('  stages.forEach(function (s, i) {');
  AW('    var bad = run.status === "failed" && run.stage === s.key;');
  AW('    var cls = bad ? "bad" : (i < active ? "done" : (i === active ? "cur" : ""));');
  AW('    h += "<div class=\"stp " + cls + "\"><div class=\"n\">" + (bad ? "!" : (i < active ? "✓" : (i + 1))) + "</div>" + s.label + "</div>";');
  AW('  });');
  AW('  h += "</div>" + (run.status === "running" ? "<div class=\"lin\" style=\"margin-top:24px\"></div>" : "") + "</div>";');
  AW('  if (run.status === "failed") {');
  AW('    h += "<div class=\"alert error\" style=\"margin:0\"><div class=\"pl\">" + esc(run.error) + "</div>";');
  AW('    if (can("runs.start")) h += "<button class=\"btn sm a\" onclick=\"resume()\">Үргэлжлүүлэх</button>";');
  AW('    h += "</div>";');
  AW('  }');
  AW('  if (run.status === "skipped") h += "<div class=\"alert info\" style=\"margin:0\">" + esc(run.note) + "</div>";');
  AW('  if (ERR) h += "<div class=\"alert error\" style=\"margin:0\">" + esc(ERR) + "</div>";');
  AW('  // stage outputs');
  AW('  if (run.selected && run.selected.length) {');
