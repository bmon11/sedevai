  AW('<div class="row">' + AdmFld('ch_model', 'Чатын загвар', 'text', 'Хямд загвар (Flash-Lite)', '') +
    AdmFld('ch_dailyLimit', 'Өдөрт AI хариулт', 'number', '0 = хязгааргүй. Хариулт ≈ $0.001', '') + '</div>');
