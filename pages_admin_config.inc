// ---- config pages: /admin/sources, /admin/social, /admin/lenses, /admin/settings, /admin/users

// ======================================================================= /admin/sources
procedure AdmPage_Sources;
begin
  if not AdmPage('Эх сурвалж', 'sources', '') then exit;
  AdmBc('Эх сурвалж', AdmCrumb('Эх сурвалж'),
    '<button class="btn o p" onclick="openWeights()">Жин тооцоолох</button><button class="btn c" onclick="editSource(-1)">' + AdmIcon('add') + 'Нэмэх</button>');
  AW('<div id="err"></div>');
  AW('<div class="card"><div class="tc"><table class="t"><thead><tr>');
  AW('<th>Нэр</th><th>Хаяг</th><th class="r">Жин</th><th>Холбоос</th><th>Нийтлэл</th><th>Идэвхтэй</th><th></th>');
  AW('</tr></thead><tbody id="rows"><tr><td colspan="7"><div class="lin"></div></td></tr></tbody></table></div></div>');
  // ---- source dialog (sections/source/source-dialog.jsx)
  AW('<div class="dlgbg" id="sDlg"><div class="dlg md"><form onsubmit="return saveSource(event)">');
  AW('<h2 id="sT">Шинэ эх сурвалж</h2><div class="bd"><div id="sErr"></div>');
  AW('<div class="row">' + AdmFld('sName', 'Нэр *', 'text', '', 'required') + AdmFld('sSlug', 'Slug *', 'text', 'жижиг латин үсэг, тоо, -', 'required') + '</div>');
  AW('<div class="row">' + AdmFld('sUrl', 'Сайтын хаяг *', 'text', '', 'required') +
    '<div style="max-width:220px;flex:1;display:flex">' + AdmFld('sWeight', 'Жин (0.5–3)', 'number', 'Нэр хүнд: 0.5 бага · 1 энгийн · 2 том · 3 тэргүүлэх', 'step="0.5" min="0.5" max="3"') + '</div></div>');
  AW(AdmSel('sRegion', 'Бүс', AdmOpt('mn', 'Монгол (Вэб / Медиа)') + AdmOpt('world', 'Гадаад'), 'Гадаад: «Гадаад мэдээ» ажиллагаа цуглуулж, нүүрний Гадаад табад гарна', ''));
  AW(AdmSw('sEnabled', 'Идэвхтэй', ''));
  AW('<div class="subt">Холбоос олох</div>');
  AW(AdmSel('sDType', 'Төрөл', AdmOpt('html', 'HTML хуудас (нүүр, ангиллын хуудас)') + AdmOpt('rss', 'RSS') + AdmOpt('sitemap', 'Sitemap') + AdmOpt('json', 'JSON API'), '', 'onchange="syncTypes()"'));
  AW(AdmFld('sDUrls', 'Хаягууд (мөр бүрт нэг)', 'textarea', '', 'rows="2"'));
  AW(AdmFld('sDPattern', 'Нийтлэлийн замын загвар (regex)', 'text', 'Жишээ: /n/[a-z0-9]+ · хоосон бол RSS эсвэл id-тай замыг автоматаар авна', ''));
  AW('<div class="row" id="dJson">' + AdmFld('sDItems', 'Жагсаалтын зам', 'text', 'result.docs', '') + AdmFld('sDLink', 'Холбоосын загвар', 'text', '/r/{lid}', '') +
    AdmFld('sDDate', 'Огнооны талбар', 'text', '', '') + '</div>');
  AW('<div id="dPages">' + AdmFld('sDMax', 'Хамгийн их хуудас', 'number', '', '') + '</div>');
  AW('<div class="subt">Нийтлэл унших</div>');
  AW(AdmSel('sAType', 'Төрөл', AdmOpt('html', 'HTML хуудас') + AdmOpt('json', 'JSON API'), '', 'onchange="syncTypes()"'));
  AW('<div class="row" id="aHtml">' + AdmFld('sASel', 'Текстийн CSS selector', 'text', 'Хоосон бол автоматаар олно', '') +
    AdmFld('sATitleSel', 'Гарчгийн selector', 'text', '', '') + AdmFld('sADateSel', 'Огнооны selector', 'text', '', '') + '</div>');
  AW('<div id="aJson" class="st" style="gap:20px">' + AdmFld('sADetail', 'Дэлгэрэнгүй API хаяг', 'text', '{path} эсвэл {last} орлуулна', ''));
  AW('<div class="row">' + AdmFld('sARoot', 'Root зам', 'text', '', '') + AdmFld('sATitleF', 'Гарчиг', 'text', '', '') + AdmFld('sATextF', 'Текст', 'text', '', '') +
    AdmFld('sADateF', 'Огноо', 'text', '', '') + AdmFld('sASkipF', 'Алгасах талбар', 'text', '', '') + '</div></div>');
  AW('<div id="sProbe"></div>');
  AW('</div><div class="ft"><span class="sp"><button type="button" class="btn e" id="sDel" onclick="delSource()">Устгах</button></span>');
  AW('<button type="button" class="btn o p" id="sProbeBtn" onclick="probeSource()">Шалгах</button>');
  AW('<button type="button" class="btn o" onclick="closeDlg(&quot;sDlg&quot;)">Болих</button>');
  AW('<button type="submit" class="btn c" id="sSave">Хадгалах</button></div></form></div></div>');
  // ---- weights dialog (sections/source/weights-dialog.jsx)
  AW('<div class="dlgbg" id="wDlg"><div class="dlg md"><h2>Жин дахин тооцоолох</h2><div class="bd">');
  AW('<div class="muted">Сүүлийн хоногуудын өгөгдлөөс жинг (0.5–3) тооцно: хамрах хүрээ (хэдэн сэдэвт орсон), анхдагч байдал (сэдвийг эхэлж мэдээлсэн эсэх), ашиглагдсан нийтлэлийн хувь. Өгөгдөл багатай эх сурвалж анхны түвшиндээ ойр үлдэнэ.</div>');
  AW('<div class="fld sm" style="max-width:120px"><label class="fl">Хоног</label><input id="wDays" type="number" min="1" max="365" value="30"></div>');
  AW('<div id="wMsg"></div><div id="wTable"></div>');
  AW('</div><div class="ft"><button class="btn" onclick="closeDlg(&quot;wDlg&quot;)">Хаах</button>');
  AW('<button class="btn o p" id="wPrev" onclick="runWeights(true)">Тооцоолох</button><button class="btn c" id="wSave" onclick="runWeights(false)">Хадгалах</button></div></div></div>');
  AW('<script>');
  AW('var SOURCES = [], EDITING = null;');
  AW('var emptySource = { slug: "", name: "", url: "https://", weight: 1, region: "mn", enabled: true,');
  AW('  discovery: { type: "html", urls: [], linkPattern: "", itemsPath: "", linkTemplate: "", dateField: "", maxPages: 5 },');
  AW('  article: { type: "html", selector: "", titleSelector: "", dateSelector: "", detailUrl: "", rootPath: "", titleField: "title", textField: "content", dateField: "publishedAt", skipField: "" } };');
  AW('function load() {');
  AW('  apiGet("/api/admin/sources").then(function (d) { SOURCES = d || []; render(); }).catch(function (e) { showErr("err", e.message); SOURCES = []; render(); });');
  AW('}');
  AW('function render() {');
  AW('  var h = "";');
  AW('  SOURCES.forEach(function (s, i) {');
  AW('    h += "<tr class=\"h\"><td>" + esc(s.name) + (s.region === "world" ? " " + lbl("Гадаад", "secondary") : "") + "</td>";');
  AW('    h += "<td class=\"muted\">" + esc(s.url) + "</td><td class=\"r\">" + (s.weight == null ? 1 : s.weight) + "</td>";');
  AW('    h += "<td>" + lbl(s.discovery ? s.discovery.type : "") + "</td><td>" + lbl(s.article ? s.article.type : "") + "</td>";');
  AW('    h += "<td><label class=\"sw\"><input type=\"checkbox\" " + (s.enabled ? "checked" : "") + " onchange=\"toggleSource(" + i + ")\"><span></span></label></td>";');
  AW('    h += "<td class=\"r\"><button class=\"btn sm t\" onclick=\"editSource(" + i + ")\">Засах</button></td></tr>";');
  AW('  });');
  AW('  if (!SOURCES.length) h = "<tr><td colspan=\"7\" class=\"empty\">Эх сурвалж алга</td></tr>";');
  AW('  $("rows").innerHTML = h;');
  AW('}');
  AW('function toggleSource(i) {');
  AW('  var s = Object.assign({}, SOURCES[i]); var id = s._id; delete s._id;');
  AW('  ["createdAt", "updatedAt", "__v"].forEach(function (k) { delete s[k]; });');
  AW('  s.enabled = !s.enabled;');
  AW('  api("PUT", "/api/admin/sources/" + id, s).then(load).catch(function (e) { showErr("err", e.message); load(); });');
  AW('}');
  AW('function syncTypes() {');
  AW('  var dt = v("sDType"), at = v("sAType");');
  AW('  show("dJson", dt === "json"); show("dPages", dt === "json" || dt === "sitemap");');
  AW('  var ht = $("f_sDUrls").querySelector(".ht");');
  AW('  if (dt === "json") { if (!ht) { ht = document.createElement("div"); ht.className = "ht"; $("f_sDUrls").appendChild(ht); } ht.textContent = "Хуудасны дугаарт {page} ашиглана"; }');
  AW('  else if (ht) ht.remove();');
  AW('  show("aHtml", at === "html"); show("aJson", at !== "html");');
  AW('}');
  AW('function editSource(i) {');
  AW('  EDITING = i < 0 ? JSON.parse(JSON.stringify(emptySource)) : SOURCES[i];');
  AW('  var s = EDITING, d = s.discovery || {}, a = s.article || {};');
  AW('  showErr("sErr", ""); $("sProbe").innerHTML = "";');
  AW('  $("sT").textContent = s._id ? s.name : "Шинэ эх сурвалж";');
  AW('  show("sDel", !!s._id);');
  AW('  setv("sName", s.name); setv("sSlug", s.slug); setv("sUrl", s.url); setv("sWeight", s.weight == null ? 1 : s.weight);');
  AW('  setv("sRegion", s.region || "mn"); setchk("sEnabled", s.enabled);');
  AW('  setv("sDType", d.type || "html"); setv("sDUrls", (d.urls || []).join("\n")); setv("sDPattern", d.linkPattern);');
  AW('  setv("sDItems", d.itemsPath); setv("sDLink", d.linkTemplate); setv("sDDate", d.dateField); setv("sDMax", d.maxPages == null ? 5 : d.maxPages);');
  AW('  setv("sAType", a.type || "html"); setv("sASel", a.selector); setv("sATitleSel", a.titleSelector); setv("sADateSel", a.dateSelector);');
  AW('  setv("sADetail", a.detailUrl); setv("sARoot", a.rootPath); setv("sATitleF", a.titleField); setv("sATextF", a.textField);');
  AW('  setv("sADateF", a.dateField); setv("sASkipF", a.skipField);');
  AW('  syncTypes(); openDlg("sDlg");');
  AW('}');
  AW('// fromForm: urls one per line -> array, numbers');
  AW('function fromForm() {');
  AW('  return { slug: v("sSlug"), name: v("sName"), url: v("sUrl"), weight: Number(v("sWeight") || 1), region: v("sRegion"), enabled: chk("sEnabled"),');
  AW('    discovery: { type: v("sDType"), urls: v("sDUrls").split("\n").map(function (u) { return u.trim(); }).filter(Boolean),');
  AW('      linkPattern: v("sDPattern"), itemsPath: v("sDItems"), linkTemplate: v("sDLink"), dateField: v("sDDate"), maxPages: Number(v("sDMax")) },');
  AW('    article: { type: v("sAType"), selector: v("sASel"), titleSelector: v("sATitleSel"), dateSelector: v("sADateSel"), detailUrl: v("sADetail"),');
  AW('      rootPath: v("sARoot"), titleField: v("sATitleF"), textField: v("sATextF"), dateField: v("sADateF"), skipField: v("sASkipF") } };');
  AW('}');
  AW('function saveSource(ev) {');
  AW('  ev.preventDefault(); showErr("sErr", "");');
  AW('  var b = $("sSave"); busy(b, true); var body = fromForm();');
  AW('  var p = EDITING._id ? api("PUT", "/api/admin/sources/" + EDITING._id, body) : api("POST", "/api/admin/sources", body);');
  AW('  p.then(function () { closeDlg("sDlg"); load(); }).catch(function (e) { showErr("sErr", e.message); }).then(function () { busy(b, false); });');
  AW('  return false;');
  AW('}');
  AW('function probeSource() {');
  AW('  showErr("sErr", ""); $("sProbe").innerHTML = "";');
  AW('  var b = $("sProbeBtn"); busy(b, true);');
  AW('  api("POST", "/api/admin/sources/probe", fromForm()).then(function (p) {');
  AW('    var samples = p.samples || [];');
  AW('    var h = "<div class=\"alert " + (samples.some(function (s) { return s.usable; }) ? "success" : "warning") + "\" style=\"margin:0\"><div>";');
  AW('    h += "<div style=\"font-weight:600\">" + (p.linkCount || 0) + " холбоос олдлоо</div>";');
  AW('    samples.forEach(function (s) {');
  AW('      h += "<div style=\"margin-top:8px\"><div>" + (s.usable ? "✓" : "✗") + " " + esc(s.title || s.url);');
  AW('      if (s.publishedDay) h += " · " + esc(s.publishedDay);');
  AW('      if (s.textLength !== undefined) h += " · " + s.textLength + " тэмдэгт";');
  AW('      h += "</div><div class=\"cap\">" + esc(s.error || (s.excerpt || "").slice(0, 160)) + "</div></div>";');
  AW('    });');
  AW('    $("sProbe").innerHTML = h + "</div></div>";');
  AW('  }).catch(function (e) { showErr("sErr", e.message); }).then(function () { busy(b, false); });');
  AW('}');
  AW('function delSource() {');
  AW('  confirmDlg("Устгах", "\"" + EDITING.name + "\" эх сурвалжийг устгах уу?", "Устгах", function () {');
  AW('    api("DELETE", "/api/admin/sources/" + EDITING._id).then(function () { closeDlg("sDlg"); load(); }).catch(function (e) { showErr("sErr", e.message); });');
  AW('  });');
  AW('}');
  AW('// weights dialog: "Тооцоолох" previews, "Хадгалах" saves');
  AW('function openWeights() { $("wMsg").innerHTML = ""; $("wTable").innerHTML = ""; openDlg("wDlg"); }');
  AW('function runWeights(dryRun) {');
  AW('  $("wMsg").innerHTML = "";');
  AW('  var b1 = $("wPrev"), b2 = $("wSave"); b1.disabled = b2.disabled = true; busy(dryRun ? b1 : b2, true);');
  AW('  api("POST", "/api/admin/sources/recalculate-weights", { days: Number(v("wDays")), dryRun: dryRun }).then(function (r) {');
  AW('    var all = r.rows || [], rows = all.filter(function (x) { return x.articles > 0; }), noData = all.length - rows.length;');
  AW('    var msg = (r.dryRun ? "Урьдчилсан үр дүн, хадгалаагүй." : "Шинэ жин хадгалагдлаа.") + (noData > 0 ? " " + noData + " эх сурвалжид өгөгдөл алга, жин нь хэвээр." : "");');
  AW('    $("wMsg").innerHTML = alertBox(r.dryRun ? "info" : "success", msg);');
  AW('    var h = "";');
  AW('    if (rows.length) {');
  AW('      h = "<div class=\"tc\"><table class=\"t\"><thead><tr><th>Эх сурвалж</th><th class=\"r\">Хуучин</th><th class=\"r\">Шинэ</th><th class=\"r\">Нийтлэл</th><th class=\"r\">Сэдэв</th><th class=\"r\">Анхдагч</th><th class=\"r\">Ашиглагдсан</th></tr></thead><tbody>";');
  AW('      rows.forEach(function (x) {');
  AW('        var col = x.weight > x.old ? "var(--ok-d)" : (x.weight < x.old ? "var(--err-d)" : "inherit");');
  AW('        h += "<tr class=\"h\"><td>" + esc(x.name) + "</td><td class=\"r\">" + x.old + "</td><td class=\"r\" style=\"font-weight:600;color:" + col + "\">" + x.weight + "</td>";');
  AW('        h += "<td class=\"r\">" + x.articles + "</td><td class=\"r\">" + x.stories + "</td><td class=\"r\">" + x.firsts + "</td><td class=\"r\">" + x.used + "</td></tr>";');
  AW('      });');
  AW('      h += "</tbody></table></div>";');
  AW('    }');
  AW('    $("wTable").innerHTML = h;');
  AW('    if (!dryRun) load();');
  AW('  }).catch(function (e) { $("wMsg").innerHTML = alertBox("error", e.message); }).then(function () { busy(b1, false); busy(b2, false); b1.disabled = b2.disabled = false; });');
  AW('}');
  AW('load();');
  AW('</script>');
  AdmFoot;
end;

// ======================================================================= /admin/social
procedure AdmPage_Social;
begin
  if not AdmPage('Сошиал', 'social', '') then exit;
  AdmBc('Сошиал', AdmCrumb('Сошиал'), '<button class="btn c" onclick="editAccount(-1)">' + AdmIcon('add') + 'Аккаунт нэмэх</button>');
  AW('<div id="err"></div>');
  AW('<div class="card"><div class="tabs bb" id="ptabs"></div>');
  AW('<div class="tabs" id="vtabs"><button class="tab on" data-t="accounts" id="accTab">Аккаунтууд (0)</button><button class="tab" data-t="posts">Постууд</button></div>');
  AW('<div id="pane"><div class="lin"></div></div></div>');
  // ---- account dialog (sections/social/account-dialog.jsx)
  AW('<div class="dlgbg" id="aDlg"><div class="dlg"><form onsubmit="return saveAccount(event)">');
  AW('<h2 id="aT">Шинэ аккаунт</h2><div class="bd"><div id="aErr"></div>');
  AW('<div class="row">' + AdmSel('aPlat', 'Платформ', AdmOpt('facebook', 'Facebook') + AdmOpt('x', 'X') + AdmOpt('threads', 'Threads'), '', 'onchange="syncExample()"') +
    AdmSel('aKind', 'Төрөл', AdmOpt('journalist', 'Сэтгүүлч') + AdmOpt('page', 'Пейж') + AdmOpt('influencer', 'Нөлөөлөгч') + AdmOpt('media', 'Хэвлэл мэдээлэл') + AdmOpt('official', 'Албан ёсны'), '', '') + '</div>');
  AW(AdmFld('aUrl', 'Профайлын хаяг *', 'text', 'Жишээ:', 'required'));
  AW(AdmFld('aName', 'Нэр *', 'text', '', 'required'));
  AW('<div class="row">' + AdmFld('aWeight', 'Жин (0.5–3)', 'number', 'Нэр хүнд: 0.5 бага · 1 энгийн · 2 том · 3 тэргүүлэх', 'step="0.5" min="0.5" max="3"') +
    AdmFld('aFollowers', 'Дагагч', 'number', 'X, Threads автоматаар шинэчилнэ', '') + '</div>');
  AW(AdmSw('aEnabled', 'Идэвхтэй', ''));
  AW('<div id="aProbe"></div>');
  AW('</div><div class="ft"><span class="sp"><button type="button" class="btn e" id="aDel" onclick="delAccount()">Устгах</button></span>');
  AW('<button type="button" class="btn o p" id="aProbeBtn" onclick="probeAccount()">Шалгах</button>');
  AW('<button type="button" class="btn o" onclick="closeDlg(&quot;aDlg&quot;)">Болих</button>');
  AW('<button type="submit" class="btn c" id="aSave">Хадгалах</button></div></form></div></div>');
  AW('<script>');
  AW('var ICONS = { facebook: ' + JEsc(AdmIcon('fb')) + ', x: ' + JEsc(AdmIcon('x')) + ', threads: ' + JEsc(AdmIcon('threads')) + ' };');
  AW('var PLATFORMS = {');
  AW('  facebook: { label: "Facebook", example: "https://www.facebook.com/ikon.mn" },');
  AW('  x: { label: "X", example: "https://x.com/username" },');
  AW('  threads: { label: "Threads", example: "https://www.threads.com/@username" }');
  AW('};');
  AW('var ACCOUNT_KINDS = { journalist: "Сэтгүүлч", page: "Пейж", influencer: "Нөлөөлөгч", media: "Хэвлэл мэдээлэл", official: "Албан ёсны" };');
  AW('var emptyAccount = { platform: "facebook", url: "", name: "", kind: "page", weight: 1, followers: 0, enabled: true };');
  AW('var PAGE_SIZE = 50, ACCOUNTS = [], PLATFORM = "all", TAB = "accounts", PAGE = 0, EDITING = null;');
  AW('function icon(p, w) { return "<span style=\"display:inline-flex;width:" + w + "px;height:" + w + "px\">" + (ICONS[p] || "").replace(/width=\"22\" height=\"22\"/, "width=\"" + w + "\" height=\"" + w + "\"") + "</span>"; }');
  AW('function load() {');
  AW('  apiGet("/api/admin/social/accounts").then(function (d) { ACCOUNTS = d || []; render(); }).catch(function (e) { showErr("err", e.message); ACCOUNTS = []; render(); });');
  AW('}');
  AW('function shown() { return PLATFORM === "all" ? ACCOUNTS : ACCOUNTS.filter(function (a) { return a.platform === PLATFORM; }); }');
  AW('function renderTabs() {');
  AW('  var h = "<button class=\"tab" + (PLATFORM === "all" ? " on" : "") + "\" onclick=\"setPlatform(&quot;all&quot;)\">Бүгд (" + ACCOUNTS.length + ")</button>";');
  AW('  Object.keys(PLATFORMS).forEach(function (k) {');
  AW('    var n = ACCOUNTS.filter(function (a) { return a.platform === k; }).length;');
  AW('    h += "<button class=\"tab" + (PLATFORM === k ? " on" : "") + "\" onclick=\"setPlatform(&quot;" + k + "&quot;)\">" + icon(k, 18) + PLATFORMS[k].label + " (" + n + ")</button>";');
  AW('  });');
  AW('  $("ptabs").innerHTML = h;');
  AW('  $("accTab").textContent = "Аккаунтууд (" + shown().length + ")";');
  AW('}');
  AW('function setPlatform(p) { PLATFORM = p; PAGE = 0; render(); }');
  AW('document.querySelectorAll("#vtabs .tab").forEach(function (b) {');
  AW('  b.onclick = function () { TAB = b.dataset.t; PAGE = 0; document.querySelectorAll("#vtabs .tab").forEach(function (x) { x.classList.toggle("on", x === b); }); render(); };');
  AW('});');
  AW('function render() {');
  AW('  renderTabs();');
  AW('  if (TAB === "posts") return renderPosts();');
  AW('  var list = shown();');
  AW('  if (!list.length) { $("pane").innerHTML = "<div class=\"empty\"><h6>Аккаунт алга</h6><div>Сэтгүүлч, пейж, нөлөөлөгчдийн аккаунтыг нэмнэ үү.</div></div>"; return; }');
  AW('  var h = "<div class=\"tc\"><table class=\"t\"><thead><tr><th>Нэр</th><th>Төрөл</th><th class=\"r\">Дагагч</th><th class=\"r\">Жин</th><th class=\"r\">Дундаж идэвх</th><th>Сүүлд цуглуулсан</th><th>Идэвхтэй</th><th></th></tr></thead><tbody>";');
  AW('  list.forEach(function (a) {');
  AW('    var i = ACCOUNTS.indexOf(a);');
  AW('    h += "<tr class=\"h\"><td><div style=\"display:flex;gap:8px;align-items:center\">" + icon(a.platform, 18) + "<a style=\"color:inherit\" target=\"_blank\" rel=\"noopener noreferrer\" href=\"" + esc(a.url) + "\">" + esc(a.name) + "</a></div></td>";');
  AW('    h += "<td>" + lbl(ACCOUNT_KINDS[a.kind] || a.kind) + "</td><td class=\"r\">" + fCount(a.followers) + "</td><td class=\"r\">" + a.weight + "</td>";');
  AW('    h += "<td class=\"r\">" + fCount(a.baseline) + "</td><td class=\"muted\">" + (a.lastCollectedAt ? fDateTimeUB(a.lastCollectedAt) : "—") + "</td>";');
  AW('    h += "<td><label class=\"sw\"><input type=\"checkbox\" " + (a.enabled ? "checked" : "") + " onchange=\"toggleAccount(" + i + ")\"><span></span></label></td>";');
  AW('    h += "<td class=\"r\"><button class=\"btn sm t\" onclick=\"editAccount(" + i + ")\">Засах</button></td></tr>";');
  AW('  });');
  AW('  $("pane").innerHTML = h + "</tbody></table></div>";');
  AW('}');
  AW('function renderPosts() {');
  AW('  $("pane").innerHTML = "<div class=\"lin\"></div>";');
  AW('  var url = "/api/admin/social/posts?page=" + PAGE + "&limit=" + PAGE_SIZE + (PLATFORM !== "all" ? "&platform=" + PLATFORM : "");');
  AW('  apiGet(url).then(function (d) {');
  AW('    var posts = (d && d.posts) || [], total = (d && d.total) || 0;');
  AW('    var h = "<div class=\"tc\"><table class=\"t\"><thead><tr><th>Огноо</th><th>Зохиогч</th><th>Текст</th><th class=\"r\">Like</th><th class=\"r\">Сэтгэгдэл</th><th class=\"r\">Түгээсэн</th><th class=\"r\">Оноо</th></tr></thead><tbody>";');
  AW('    posts.forEach(function (p) {');
  AW('      var m = p.metrics || {};');
  AW('      h += "<tr class=\"h\"><td class=\"muted\" style=\"white-space:nowrap\">" + fDateTimeUB(p.postedAt) + "</td>";');
  AW('      h += "<td style=\"white-space:nowrap\"><div style=\"display:flex;gap:8px;align-items:center\">" + icon(p.platform, 16) + esc(p.author ? p.author.name : "") + "</div></td>";');
  AW('      h += "<td style=\"max-width:420px\"><a style=\"color:inherit\" target=\"_blank\" rel=\"noopener noreferrer\" href=\"" + esc(p.url) + "\">" + esc((p.text || "").slice(0, 140) || "—") + "</a></td>";');
  AW('      h += "<td class=\"r\">" + fCount(m.likes) + "</td><td class=\"r\">" + fCount(m.comments) + "</td><td class=\"r\">" + fCount(m.shares) + "</td>";');
  AW('      h += "<td class=\"r\">" + (typeof p.score === "number" ? p.score.toFixed(1) : "—") + "</td></tr>";');
  AW('    });');
  AW('    h += "</tbody></table></div>";');
  AW('    var from = total ? PAGE * PAGE_SIZE + 1 : 0, to = Math.min(total, (PAGE + 1) * PAGE_SIZE);');
  AW('    h += "<div style=\"display:flex;justify-content:flex-end;align-items:center;gap:16px;padding:8px 16px\"><span>" + from + "–" + to + " / " + total + "</span>";');
  AW('    h += "<button class=\"ib\" " + (PAGE === 0 ? "disabled" : "") + " onclick=\"PAGE--;renderPosts()\" aria-label=\"Өмнөх\">‹</button>";');
  AW('    h += "<button class=\"ib\" " + (to >= total ? "disabled" : "") + " onclick=\"PAGE++;renderPosts()\" aria-label=\"Дараах\">›</button></div>";');
  AW('    $("pane").innerHTML = h;');
  AW('  }).catch(function (e) { $("pane").innerHTML = alertBox("error", e.message); });');
  AW('}');
  AW('function bodyOf(a) {');
  AW('  return { platform: a.platform, url: (a.url || "").trim(), name: a.name, kind: a.kind, weight: Number(a.weight), followers: Number(a.followers) || 0, enabled: a.enabled };');
  AW('}');
  AW('function toggleAccount(i) {');
  AW('  var a = ACCOUNTS[i], b = bodyOf(a); b.enabled = !a.enabled;');
  AW('  api("PUT", "/api/admin/social/accounts/" + a._id, b).then(load).catch(function (e) { showErr("err", e.message); load(); });');
  AW('}');
  AW('function syncExample() { $("h_aUrl").textContent = "Жишээ: " + (PLATFORMS[v("aPlat")] || {}).example; }');
  AW('function editAccount(i) {');
  AW('  EDITING = i < 0 ? emptyAccount : ACCOUNTS[i]; var a = Object.assign({}, emptyAccount, EDITING);');
  AW('  showErr("aErr", ""); $("aProbe").innerHTML = "";');
  AW('  $("aT").textContent = EDITING._id ? EDITING.name : "Шинэ аккаунт"; show("aDel", !!EDITING._id);');
  AW('  setv("aPlat", a.platform); setv("aKind", a.kind); setv("aUrl", a.url); setv("aName", a.name);');
  AW('  setv("aWeight", a.weight); setv("aFollowers", a.followers); setchk("aEnabled", a.enabled);');
  AW('  syncExample(); openDlg("aDlg");');
  AW('}');
  AW('function formAccount() { return bodyOf({ platform: v("aPlat"), url: v("aUrl"), name: v("aName"), kind: v("aKind"), weight: v("aWeight"), followers: v("aFollowers"), enabled: chk("aEnabled") }); }');
  AW('function saveAccount(ev) {');
  AW('  ev.preventDefault(); showErr("aErr", "");');
  AW('  var b = $("aSave"); busy(b, true); var body = formAccount();');
  AW('  var p = EDITING._id ? api("PUT", "/api/admin/social/accounts/" + EDITING._id, body) : api("POST", "/api/admin/social/accounts", body);');
  AW('  p.then(function () { closeDlg("aDlg"); load(); }).catch(function (e) { showErr("aErr", e.message); }).then(function () { busy(b, false); });');
  AW('  return false;');
  AW('}');
  AW('function probeAccount() {');
  AW('  showErr("aErr", ""); $("aProbe").innerHTML = "";');
  AW('  var b = $("aProbeBtn"); busy(b, true);');
  AW('  api("POST", "/api/admin/social/accounts/probe", formAccount()).then(function (p) {');
  AW('    var h = "<div class=\"alert " + (p.count ? "success" : "warning") + "\" style=\"margin:0\"><div><div style=\"font-weight:600\">" + (p.count || 0) + " пост олдлоо</div>";');
  AW('    (p.samples || []).forEach(function (s) {');
  AW('      var m = s.metrics || {};');
  AW('      h += "<div style=\"margin-top:8px\"><div class=\"cap\">" + esc(s.authorName) + " · ❤ " + fCount(m.likes) + " · 💬 " + fCount(m.comments) + " · ↻ " + fCount(m.shares);');
  AW('      if (s.followers) h += " · " + fCount(s.followers) + " дагагч";');
  AW('      h += "</div><div>" + esc((s.text || "").slice(0, 160)) + "</div></div>";');
  AW('    });');
  AW('    $("aProbe").innerHTML = h + "</div></div>";');
  AW('  }).catch(function (e) { showErr("aErr", e.message); }).then(function () { busy(b, false); });');
  AW('}');
  AW('function delAccount() {');
  AW('  confirmDlg("Устгах", "\"" + EDITING.name + "\" аккаунт болон цуглуулсан постуудыг устгах уу?", "Устгах", function () {');
  AW('    api("DELETE", "/api/admin/social/accounts/" + EDITING._id).then(function () { closeDlg("aDlg"); load(); }).catch(function (e) { showErr("aErr", e.message); });');
  AW('  });');
  AW('}');
  AW('load();');
  AW('</script>');
  AdmFoot;
end;

// ======================================================================= /admin/lenses
procedure AdmPage_Lenses;
begin
  if not AdmPage('Задлах цэгүүд', 'lenses', '') then exit;
  AdmBc('Задлах цэгүүд', AdmCrumb('Задлах цэгүүд'), '<button class="btn c" onclick="editLens(-1)">' + AdmIcon('add') + 'Нэмэх</button>');
  AW('<div class="alert info">Сэдэв бүрийг эдгээр цэгээр задлан шинжилнэ. Дараалал нь сэдвийн хуудсан дээрх уншлагын дараалал. Өөрчлөлт дараагийн ажиллагаанаас хэрэгжинэ.</div>');
  AW('<div id="err"></div>');
  AW('<div class="card"><ul class="lst" id="list"><li><div class="lin" style="flex:1"></div></li></ul></div>');
  // ---- lens dialog (sections/lens/lens-dialog.jsx)
  AW('<div class="dlgbg" id="lDlg"><div class="dlg"><form onsubmit="return saveLens(event)">');
  AW('<h2 id="lT">Шинэ задлах цэг</h2><div class="bd"><div id="lErr"></div>');
  AW(AdmFld('lLabel', 'Гарчиг *', 'text', 'Уншигчид харагдах нэр', 'required'));
  AW(AdmFld('lKey', 'Түлхүүр *', 'text', 'Латин жижиг үсэг, тоо, _ (жишээ: why_trending)', 'required'));
  AW(AdmSel('lFormat', 'Хэлбэр', AdmOpt('text', 'Текст — догол мөр') + AdmOpt('list', 'Жагсаалт') + AdmOpt('keypoints', 'Гол санаа — тодруулсан карт') +
    AdmOpt('facts', 'Тоон баримт — тоо + тайлбар') + AdmOpt('timeline', 'Он цагийн дараалал') + AdmOpt('perspectives', 'Талуудын байр суурь') +
    AdmOpt('proscons', 'Сайн / муу тал'), '', ''));
  AW(AdmFld('lInstr', 'AI-д өгөх заавар *', 'textarea', 'Энэ цэгээр сэдвийг юуг, хэрхэн задлахыг тодорхой бичнэ', 'required rows="4"'));
  AW('</div><div class="ft"><span class="sp"><button type="button" class="btn e" id="lDel" onclick="delLens()">Устгах</button></span>');
  AW('<button type="button" class="btn o" onclick="closeDlg(&quot;lDlg&quot;)">Болих</button>');
  AW('<button type="submit" class="btn c" id="lSave">Хадгалах</button></div></form></div></div>');
  AW('<script>');
  AW('var FORMAT_LABELS = { text: "Текст — догол мөр", list: "Жагсаалт", keypoints: "Гол санаа — тодруулсан карт", facts: "Тоон баримт — тоо + тайлбар",');
  AW('  timeline: "Он цагийн дараалал", perspectives: "Талуудын байр суурь", proscons: "Сайн / муу тал" };');
  AW('var emptyLens = { key: "", label: "", instruction: "", format: "text", enabled: true };');
  AW('var LENSES = [], EDITING = null;');
  AW('var UP = ' + JEsc(AdmIcon('up')) + ', DOWN = ' + JEsc(AdmIcon('down')) + ';');
  AW('function load() {');
  AW('  apiGet("/api/admin/lenses").then(function (d) { LENSES = d || []; render(); }).catch(function (e) { showErr("err", e.message); LENSES = []; render(); });');
  AW('}');
  AW('function render() {');
  AW('  var h = "";');
  AW('  LENSES.forEach(function (l, i) {');
  AW('    h += "<li class=\"" + (l.enabled ? "" : "dim") + "\"><div class=\"tx\"><div class=\"p\">" + esc(l.label) + " " + lbl(FORMAT_LABELS[l.format] || l.format) + "</div>";');
  AW('    h += "<div class=\"s\">" + esc(l.instruction) + "</div></div>";');
  AW('    h += "<div style=\"display:flex;align-items:center;flex-shrink:0\">";');
  AW('    h += "<button class=\"ib\" aria-label=\"Дээш\" " + (i === 0 ? "disabled" : "") + " onclick=\"move(" + i + ",-1)\">" + UP + "</button>";');
  AW('    h += "<button class=\"ib\" aria-label=\"Доош\" " + (i === LENSES.length - 1 ? "disabled" : "") + " onclick=\"move(" + i + ",1)\">" + DOWN + "</button>";');
  AW('    h += "<label class=\"sw\"><input type=\"checkbox\" " + (l.enabled ? "checked" : "") + " onchange=\"toggleLens(" + i + ")\"><span></span></label>";');
  AW('    h += "<button class=\"btn sm t\" onclick=\"editLens(" + i + ")\">Засах</button></div></li>";');
  AW('  });');
  AW('  if (!LENSES.length) h = "<li><div class=\"empty\" style=\"flex:1\">Задлах цэг алга</div></li>";');
  AW('  $("list").innerHTML = h;');
  AW('}');
  AW('function move(i, delta) {');
  AW('  var ids = LENSES.map(function (l) { return l._id; });');
  AW('  var t = ids[i]; ids[i] = ids[i + delta]; ids[i + delta] = t;');
  AW('  api("PUT", "/api/admin/lenses/order", { ids: ids }).then(function (d) { if (Array.isArray(d)) { LENSES = d; render(); } else load(); })');
  AW('    .catch(function (e) { showErr("err", e.message); });');
  AW('}');
  AW('function toggleLens(i) {');
  AW('  var l = LENSES[i];');
  AW('  api("PUT", "/api/admin/lenses/" + l._id, { key: l.key, label: l.label, instruction: l.instruction, format: l.format, enabled: !l.enabled })');
  AW('    .then(load).catch(function (e) { showErr("err", e.message); load(); });');
  AW('}');
  AW('function editLens(i) {');
  AW('  EDITING = i < 0 ? emptyLens : LENSES[i]; showErr("lErr", "");');
  AW('  $("lT").textContent = EDITING._id ? EDITING.label : "Шинэ задлах цэг"; show("lDel", !!EDITING._id);');
  AW('  setv("lLabel", EDITING.label); setv("lKey", EDITING.key); setv("lFormat", EDITING.format || "text"); setv("lInstr", EDITING.instruction);');
  AW('  openDlg("lDlg");');
  AW('}');
  AW('function saveLens(ev) {');
  AW('  ev.preventDefault(); showErr("lErr", "");');
  AW('  var body = { key: v("lKey"), label: v("lLabel"), instruction: v("lInstr"), format: v("lFormat"), enabled: EDITING.enabled !== false };');
  AW('  var b = $("lSave"); busy(b, true);');
  AW('  var p = EDITING._id ? api("PUT", "/api/admin/lenses/" + EDITING._id, body) : api("POST", "/api/admin/lenses", body);');
  AW('  p.then(function () { closeDlg("lDlg"); load(); }).catch(function (e) { showErr("lErr", e.message); }).then(function () { busy(b, false); });');
  AW('  return false;');
  AW('}');
  AW('function delLens() {');
  AW('  confirmDlg("Устгах", "\"" + EDITING.label + "\" цэгийг устгах уу?", "Устгах", function () {');
  AW('    api("DELETE", "/api/admin/lenses/" + EDITING._id).then(function () { closeDlg("lDlg"); load(); }).catch(function (e) { showErr("lErr", e.message); });');
  AW('  });');
  AW('}');
  AW('load();');
  AW('</script>');
  AdmFoot;
end;

