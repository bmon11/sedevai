  AW('<div><button type="submit" class="btn c" id="save">Хадгалах</button></div>');
  AW('</div></form></div>');
  AW('<script>');
  AW('var JOBS = ["news", "social", "publish", "world"];');
  AW('var NUMBER_FIELDS = ["windowDays", "topicsPerRun", "articlesPerSource", "dailyTokenLimit", "minNewItems"];');
  AW('var CRON_PRESETS = [');
  AW('  { label: "Цаг тутам", cron: "0 * * * *" }, { label: "Цаг тутам, 07–21 цаг", cron: "0 7-21 * * *" },');
  AW('  { label: "Цаг тутам, 08–22 цаг", cron: "0 8-22 * * *" }, { label: "08–22 цаг, :10 минутад", cron: "10 8-22 * * *" },');
  AW('  { label: "3 цаг", cron: "0 */3 * * *" }, { label: "3 цаг, 08:30–20:30", cron: "30 8-20/3 * * *" },');
  AW('  { label: "6 цаг", cron: "30 */6 * * *" }, { label: "12 цаг", cron: "30 */12 * * *" },');
  AW('  { label: "08, 14, 20 цаг", cron: "0 8,14,20 * * *" }, { label: "Өдөрт 1 (08:00)", cron: "0 8 * * *" }');
  AW('];');
  AW('var S = null;');
  AW('function g(o, path, def) { var x = o; path.split(".").forEach(function (k) { x = x == null ? undefined : x[k]; }); return x == null ? def : x; }');
  AW('function paintChips() {');
  AW('  JOBS.forEach(function (k) {');
  AW('    var cur = v("sc_" + k + "_cron");');
  AW('    $("pr_" + k).innerHTML = CRON_PRESETS.map(function (p) {');
  AW('      return "<button type=\"button\" class=\"chip" + (p.cron === cur ? " on" : "") + "\" onclick=\"setv(&quot;sc_" + k + "_cron&quot;,&quot;" + p.cron + "&quot;);paintChips()\">" + esc(p.label) + "</button>";');
  AW('    }).join("");');
  AW('  });');
  AW('}');
  AW('function fill(s) {');
  AW('  S = s;');
  AW('  JOBS.forEach(function (k) {');
  AW('    setchk("sc_" + k + "_on", g(s, "schedules." + k + ".enabled", false)); setv("sc_" + k + "_cron", g(s, "schedules." + k + ".cron", ""));');
  AW('    var nx = s.nextRuns && s.nextRuns[k]; $("nx_" + k).textContent = nx ? " · Дараагийнх: " + fDateTimeUB(nx) : "";');
  AW('  });');
  AW('  paintChips();');
  AW('  NUMBER_FIELDS.forEach(function (f) { setv(f, s[f]); });');
  AW('  setchk("so_enabled", g(s, "social.enabled", false));');
  AW('  ["facebook", "x", "threads"].forEach(function (p) {');
  AW('    var opts = (s.providerOptions && s.providerOptions[p]) || [], cur = g(s, "social.providers." + p, "");');
  AW('    if (cur && !opts.some(function (o) { return o.id === cur; })) opts = opts.concat([{ id: cur, label: cur }]);');
  AW('    $("pv_" + p).innerHTML = opts.map(function (o) { return "<option value=\"" + esc(o.id) + "\">" + esc(o.label) + "</option>"; }).join("");');
  AW('    setv("pv_" + p, cur);');
  AW('  });');
  AW('  ["creditUsd", "postsPerAccount", "postsPerRun", "halfLifeHours", "overlapHours"].forEach(function (f) { setv("so_" + f, g(s, "social." + f, "")); });');
  AW('  ["news", "social", "velocity"].forEach(function (f) { setv("hw_" + f, g(s, "hotWeights." + f, "")); });');
  AW('  ["windowDays", "topicsPerRun", "minNewItems", "articlesPerSource"].forEach(function (f) { setv("wo_" + f, g(s, "world." + f, "")); });');
  AW('  setchk("au_enabled", g(s, "audio.enabled", false)); setv("au_model", g(s, "audio.model", "")); setv("au_voice", g(s, "audio.voice", "")); setv("au_dailyLimit", g(s, "audio.dailyLimit", ""));');
  AW('  setchk("ch_enabled", g(s, "chat.enabled", false)); setv("ch_model", g(s, "chat.model", "")); setv("ch_dailyLimit", g(s, "chat.dailyLimit", ""));');
  AW('  ["cluster", "select", "wrap", "extract"].forEach(function (f) { setv("mo_" + f, g(s, "models." + f, "")); });');
  AW('  show("loading", false); show("form", true);');
  AW('}');
  AW('function saveSettings(ev) {');
  AW('  ev.preventDefault(); $("msg").innerHTML = "";');
  AW('  var sch = {}; JOBS.forEach(function (k) { sch[k] = { enabled: chk("sc_" + k + "_on"), cron: v("sc_" + k + "_cron") }; });');
  AW('  var body = {');
  AW('    schedules: sch,');
  AW('    models: { cluster: v("mo_cluster"), select: v("mo_select"), wrap: v("mo_wrap"), extract: v("mo_extract") },');
  AW('    social: { enabled: chk("so_enabled"), providers: { facebook: v("pv_facebook"), x: v("pv_x"), threads: v("pv_threads") },');
  AW('      creditUsd: Number(v("so_creditUsd")), postsPerAccount: Number(v("so_postsPerAccount")), postsPerRun: Number(v("so_postsPerRun")),');
  AW('      halfLifeHours: Number(v("so_halfLifeHours")), overlapHours: Number(v("so_overlapHours")) },');
  AW('    hotWeights: { news: Number(v("hw_news")), social: Number(v("hw_social")), velocity: Number(v("hw_velocity")) },');
  AW('    world: { windowDays: Number(v("wo_windowDays")), topicsPerRun: Number(v("wo_topicsPerRun")), minNewItems: Number(v("wo_minNewItems")),');
  AW('      articlesPerSource: Number(v("wo_articlesPerSource")) },');
  AW('    audio: { enabled: chk("au_enabled"), model: v("au_model"), voice: v("au_voice"), dailyLimit: Number(v("au_dailyLimit")) },');
  AW('    chat: { enabled: chk("ch_enabled"), model: v("ch_model"), dailyLimit: Number(v("ch_dailyLimit")) }');
  AW('  };');
  AW('  NUMBER_FIELDS.forEach(function (f) { body[f] = Number(v(f)); });');
  AW('  var b = $("save"); busy(b, true);');
  AW('  api("PUT", "/api/admin/settings", body).then(function (d) { if (d) fill(d); $("msg").innerHTML = alertBox("success", "Хадгаллаа"); })');
  AW('    .catch(function (e) { $("msg").innerHTML = alertBox("error", e.message, "pl"); }).then(function () { busy(b, false); });');
  AW('  return false;');
  AW('}');
  AW('apiGet("/api/admin/settings").then(fill).catch(function (e) { $("loading").innerHTML = alertBox("error", e.message); });');
  AW('</script>');
  AdmFoot;
end;

// ======================================================================= /admin/users
procedure AdmPage_Users;
begin
  if not AdmPage('Хэрэглэгчид', 'users', '') then exit;
  AdmBc('Хэрэглэгчид', AdmCrumb('Хэрэглэгчид'), '<button class="btn c" onclick="editUser(-1)">' + AdmIcon('add') + 'Нэмэх</button>');
  AW('<div class="alert info">Эрх тус бүрийн боломжийг ажилтны гарын авлагаас харна уу. Админ зөвхөн редактор, модератор, сэтгүүлчийн бүртгэлийг удирдана.</div>');
  AW('<div id="err"></div>');
  AW('<div class="card"><div class="tc"><table class="t"><thead><tr>');
  AW('<th>Нэвтрэх нэр</th><th>Овог нэр</th><th>Эрх</th><th>Төлөв</th><th>Сүүлд нэвтэрсэн</th><th></th>');
  AW('</tr></thead><tbody id="rows"><tr><td colspan="6"><div class="lin"></div></td></tr></tbody></table></div></div>');
  // ---- user dialog (sections/user/user-dialog.jsx)
  AW('<div class="dlgbg" id="uDlg"><div class="dlg xs"><form onsubmit="return saveUser(event)">');
  AW('<h2 id="uT">Шинэ хэрэглэгч</h2><div class="bd"><div id="uErr"></div>');
  AW(AdmFld('uName', 'Нэвтрэх нэр *', 'text', 'Латин жижиг үсэг, тоо, . _ - (3–32 тэмдэгт)', 'required'));
  AW(AdmFld('uFull', 'Овог нэр', 'text', '', ''));
  AW(AdmSel('uRole', 'Эрх', '', '', ''));
  AW(AdmFld('uPw', 'Нууц үг', 'password', 'Хамгийн багадаа 8 тэмдэгт', 'autocomplete="new-password"'));
  AW(AdmSw('uActive', 'Идэвхтэй', ''));
  AW('</div><div class="ft"><span class="sp"><button type="button" class="btn e" id="uDel" onclick="delUser()">Устгах</button></span>');
  AW('<button type="button" class="btn o" onclick="closeDlg(&quot;uDlg&quot;)">Болих</button>');
  AW('<button type="submit" class="btn c" id="uSave">Хадгалах</button></div></form></div></div>');
  AW('<script>');
  AW('var USERS = [], MANAGEABLE = [], EDITING = null;');
  AW('var emptyUser = { username: "", name: "", role: "journalist", active: true };');
  AW('function load() {');
  AW('  apiGet("/api/admin/users").then(function (d) { USERS = (d && d.users) || []; MANAGEABLE = (d && d.manageableRoles) || []; render(); })');
  AW('    .catch(function (e) { showErr("err", e.message); USERS = []; render(); });');
  AW('}');
  AW('function render() {');
  AW('  var h = "";');
  AW('  USERS.forEach(function (u, i) {');
  AW('    h += "<tr class=\"h" + (u.active ? "" : " dim") + "\"><td>" + esc(u.username) + "</td><td>" + esc(u.name) + "</td>";');
  AW('    h += "<td>" + lbl(roleLabel(u.role), ROLES[u.role] ? ROLES[u.role].color : "") + "</td>";');
  AW('    h += "<td>" + (u.active ? "Идэвхтэй" : "Хаагдсан") + "</td><td>" + (u.lastLoginAt ? fDateTimeUB(u.lastLoginAt) : "—") + "</td>";');
  AW('    h += "<td class=\"r\">" + (MANAGEABLE.indexOf(u.role) >= 0 ? "<button class=\"btn sm t\" onclick=\"editUser(" + i + ")\">Засах</button>" : "") + "</td></tr>";');
  AW('  });');
  AW('  if (!USERS.length) h = "<tr><td colspan=\"6\" class=\"empty\">Хэрэглэгч алга</td></tr>";');
  AW('  $("rows").innerHTML = h;');
  AW('}');
  AW('function editUser(i) {');
  AW('  EDITING = i < 0 ? emptyUser : USERS[i];');
  AW('  var isSelf = !!EDITING._id && EDITING._id === ME.id;');
  AW('  showErr("uErr", "");');
  AW('  $("uT").textContent = EDITING._id ? EDITING.username : "Шинэ хэрэглэгч";');
  AW('  setv("uName", EDITING.username); setv("uFull", EDITING.name); setv("uPw", "");');
  AW('  $("uRole").innerHTML = MANAGEABLE.map(function (r) { return "<option value=\"" + r + "\">" + esc(roleLabel(r)) + "</option>"; }).join("");');
  AW('  setv("uRole", EDITING.role); $("uRole").disabled = isSelf;');
  AW('  setchk("uActive", EDITING.active); $("uActive").disabled = isSelf;');
  AW('  $("f_uPw").querySelector(".fl").textContent = EDITING._id ? "Шинэ нууц үг" : "Нууц үг *";');
  AW('  $("uPw").required = !EDITING._id;');
  AW('  $("h_uPw").textContent = EDITING._id ? "Солихгүй бол хоосон үлдээнэ. 8+ тэмдэгт" : "Хамгийн багадаа 8 тэмдэгт";');
  AW('  show("uDel", !!EDITING._id && !isSelf);');
  AW('  openDlg("uDlg");');
  AW('}');
  AW('function saveUser(ev) {');
  AW('  ev.preventDefault(); showErr("uErr", "");');
  AW('  var body = { username: v("uName"), name: v("uFull"), role: v("uRole"), active: chk("uActive"), password: v("uPw") };');
  AW('  var b = $("uSave"); busy(b, true);');
  AW('  var p = EDITING._id ? api("PUT", "/api/admin/users/" + EDITING._id, body) : api("POST", "/api/admin/users", body);');
  AW('  p.then(function () { closeDlg("uDlg"); load(); }).catch(function (e) { showErr("uErr", e.message); }).then(function () { busy(b, false); });');
  AW('  return false;');
  AW('}');
  AW('function delUser() {');
  AW('  confirmDlg("Устгах", "\"" + EDITING.username + "\" хэрэглэгчийг устгах уу? Түр хаах бол \"Идэвхтэй\"-г унтраана уу.", "Устгах", function () {');
  AW('    api("DELETE", "/api/admin/users/" + EDITING._id).then(function () { closeDlg("uDlg"); load(); }).catch(function (e) { showErr("uErr", e.message); });');
  AW('  });');
  AW('}');
  AW('load();');
  AW('</script>');
  AdmFoot;
end;
